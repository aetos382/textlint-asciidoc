# GitHub の branch ruleset で main は保護されている。
# main への merge や main 自体の rebase などの大掛かりな操作はそっちで止める。
# ここでは、ブランチの切り忘れというありがちなミスを早期に防止するに留める。

[hook "block-commit-to-main"]
  event = pre-commit
  command = bash .githooks/block-commit-to-main.sh

# 整形漏れは CI の npm run lint でも検出されるが、push する前に気付けるようにする。
[hook "prettier-check"]
  event = pre-commit
  command = bash .githooks/prettier-check.sh

# renovate.json の誤りは Renovate が PR を作らなくなるまで気付きにくいので、コミットする前に検証する。
[hook "validate-renovate-config"]
  event = pre-commit
  command = bash .githooks/validate-renovate-config.sh
