{
  "name": "@aetos382/textlint-plugin-asciidoc",
  "version": "0.1.0",
  "description": "AsciiDoc support for textlint",
  "keywords": [
    "textlint",
    "textlintplugin",
    "asciidoc",
    "asciidoctor"
  ],
  "homepage": "https://github.com/aetos382/textlint-asciidoc",
  "bugs": {
    "url": "https://github.com/aetos382/textlint-asciidoc/issues"
  },
  "repository": "github:aetos382/textlint-asciidoc",
  "license": "MIT",
  "author": {
    "name": "aetos",
    "url": "https://github.com/aetos382"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "update-snapshot": "vitest run --update",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@asciidoctor/core": "^4.1.0",
    "@textlint/ast-node-types": "^15.8.0",
    "@textlint/types": "^15.8.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@textlint/ast-tester": "15.8.0",
    "@textlint/kernel": "15.8.0",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "textlint": "15.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
